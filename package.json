{
	"name": "device-driver",
	"description": "Official vscode extension for device-driver",
	"author": "Dion Dokter",
	"license": "MIT",
	"version": "1.0.0",
	"icon": "./ddsl.png",
	"homepage": "device-driver.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/diondokter/device-driver-vscode"
	},
	"publisher": "diondokter",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"device-driver",
		"vscode",
		"extension"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension",
	"contributes": {
		"languages": [
			{
				"id": "ddsl",
				"aliases": [
					"ddsl",
					"DDSL"
				],
				"extensions": [
					".ddsl"
				],
				"configuration": "language-configuration.json"
			}
		],
		"configuration": {
			"title": "device-driver",
			"properties": {
				"device-driver.language-server-binary": {
					"scope": "machine",
					"type": "string",
					"description": "Path to the DDC binary",
					"default": "ddc"
				},
				"device-driver.language-server-enabled": {
					"scope": "machine",
					"type": "boolean",
					"description": "Should the LSP be activated?",
					"default": "true"
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "ddsl",
				"scopes": {
					"keyword": [
						"keyword.other"
					],
					"keyword.expression": [
						"keyword.control"
					]
				}
			}
		],
		"grammars": [
			{
				"language": "ddsl",
				"scopeName": "source.ddsl",
				"path": "./ddsl.tmGrammar.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@types/vscode": "^1.100.0",
		"typescript": "^6.0.3"
	}
}