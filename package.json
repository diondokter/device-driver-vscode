{
	"name": "device-driver-language-server",
	"description": "Vscode extension for device-driver",
	"author": "Dion Dokter",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/diondokter/device-driver-vscode"
	},
	"publisher": "diondokter",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"device-driver",
		"vscode",
		"extension"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension",
	"contributes": {
		"languages": [
			{
				"id": "DDSL",
				"extensions": [
					".ddsl"
				],
				"configuration": "language-configuration.json"
			}
		],
		"configuration": {
			"title": "Device-driver",
			"properties": {
				"device-driver-language-server.language-server-binary": {
					"scope": "machine",
					"type": "string",
					"description": "Path to the DDC binary",
					"default": "ddc"
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "DDSL",
				"scopes": {
					"keyword": [
						"keyword.other"
					],
					"keyword.expression": [
						"keyword.control"
					]
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.2",
		"@types/vscode": "^1.138.0",
		"eslint": "^10.11.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}