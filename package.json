{
	"name": "device-driver-language-server",
	"description": "Vscode extension for device-driver",
	"author": "Dion Dokter",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/diondokter/device-driver-vscode"
	},
	"publisher": "diondokter",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"device-driver",
		"vscode",
		"extension"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onLanguage:DDSL"
	],
	"contributes": {
		"languages": [
			{
				"id": "DDSL",
				"extensions": [
					".ddsl"
				]
			}
		],
		"configuration": {
			"title": "Device-driver",
			"properties": {
				"device-driver-language-server.language-server-binary": {
					"scope": "machine",
					"type": "string",
					"description": "Path to the DDC binary",
					"default": "ddc"
				},
				"device-driver-language-server.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "DDSL",
				"scopes": {
					"nodetype": [
						"keyword"
					],
					"access": [
						"keyword"
					],
					"byteorder": [
						"keyword"
					],
					"addressmode": [
						"keyword"
					]
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.100.0",
		"@vscode/test-electron": "^2.3.9",
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}