{
	"name": "device-driver",
	"description": "Official vscode extension for device-driver",
	"author": "Dion Dokter",
	"license": "MIT",
	"version": "1.0.1",
	"icon": "./ddsl.png",
	"homepage": "https://device-driver.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/diondokter/device-driver-vscode"
	},
	"publisher": "diondokter",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"device-driver",
		"vscode",
		"extension"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./dist/extension",
	"contributes": {
		"languages": [
			{
				"id": "ddsl",
				"aliases": [
					"ddsl",
					"DDSL"
				],
				"extensions": [
					".ddsl"
				],
				"configuration": "language-configuration.json",
				"icon": {
					"light": "ddsl.png",
					"dark": "ddsl.png"
				}
			}
		],
		"configuration": {
			"title": "device-driver",
			"properties": {
				"device-driver.language-server-binary": {
					"scope": "machine",
					"type": "string",
					"description": "Path to the DDC binary",
					"default": "ddc"
				},
				"device-driver.language-server-enabled": {
					"scope": "machine",
					"type": "boolean",
					"description": "Should the LSP be activated?",
					"default": "true"
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "ddsl",
				"scopes": {
					"keyword": [
						"keyword.other"
					],
					"keyword.expression": [
						"keyword.control"
					]
				}
			}
		],
		"grammars": [
			{
				"language": "ddsl",
				"scopeName": "source.ddsl",
				"path": "./syntaxes/ddsl.tmGrammar.json"
			}
		]
	},
	"scripts": {
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@types/vscode": "^1.100.0",
		"esbuild": "^0.28.2",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
