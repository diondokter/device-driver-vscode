{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.ddsl",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#number"
    },
    {
      "include": "#delimiter"
    },
    {
      "match": "([\\w][\\w-]*)(:)",
      "captures": {
        "1": {
          "name": "variable"
        },
        "2": {
          "name": ""
        }
      }
    },
    {
      "include": "#string"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#keyword_expression"
    },
    {
      "include": "#base_types"
    },
    {
      "include": "#operator"
    },
    {
      "match": "(manifest|device|register|command|buffer|block|extern|enum|fieldset|field)\\s*([\\w-]+)",
      "captures": {
        "1": {
          "name": "keyword"
        },
        "2": {
          "name": "entity.name.type"
        }
      }
    },
    {
      "match": "[\\w-]+",
      "name": "entity.name.type",
      "comment": "Backstop for any missed identifier"
    }
  ],
  "repository": {
    "keyword": {
      "match": "allow|LE|BE|RO|RW|WO|mapped|indexed",
      "name": "keyword"
    },
    "keyword_expression": {
      "match": "default|catch-all|as|stride|try",
      "name": "keyword.control"
    },
    "string": {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\""
    },
    "comment": {
      "begin": "//",
      "end": "$",
      "name": "comment.line"
    },
    "base_types": {
      "match": "bool|int|uint|u8|u16|u32|u64|i8|i16|i32|i64",
      "name": "support.type"
    },
    "number": {
      "patterns": [
        {
          "match": "-?0x[_0-9a-fA-F]+",
          "name": "constant.numeric"
        },
        {
          "match": "-?0o[_0-7]+",
          "name": "constant.numeric"
        },
        {
          "match": "-?0b[_0-1]+",
          "name": "constant.numeric"
        },
        {
          "match": "-?[0-9][_0-9]*",
          "name": "constant.numeric"
        }
      ]
    },
    "delimiter": {
      "match": ":|[|]"
    },
    "operator": {
      "match": "->",
      "name": "keyword.operator"
    }
  }
}